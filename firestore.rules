rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // 교사 인증은 두 가지를 모두 인정한다.
    //  1) teacherSessions — 핀 번호를 맞게 입력해서 연 세션 (기본 방식)
    //  2) admins — 콘솔에서 직접 등록한 Google 계정 (비상용·기존 방식)
    function isAdmin() {
      return request.auth != null
        && (exists(/databases/$(db)/documents/teacherSessions/$(request.auth.uid))
          || exists(/databases/$(db)/documents/admins/$(request.auth.uid)));
    }
    function validStudentId(id) { return id.matches('^1[0-9]{4}$'); }
    function validName(n) { return n is string && n.size() >= 2 && n.size() <= 10; }
    function minTime(level) {
      return {'beginner': 1000, 'intermediate': 3000, 'expert': 8000}[level];
    }

    // ── 접속 허용 시간 ────────────────────────────────────────────────
    // 선생님 화면의 "접속 허용" 설정을 서버에서도 확인한다.
    // 학생 화면만 막으면 기기 시계를 바꿔서 넘어갈 수 있기 때문이다.
    //
    // 규칙 언어에는 반복문이 없어서 시간대(09:00~09:45)를 그대로 볼 수 없다.
    // 대신 앱이 허용 시간대를 5분 조각으로 펼쳐 config/app.slots 에 넣어 두고,
    // 여기서는 "지금 조각이 그 목록에 있는가"만 확인한다. (src/lib/schedule.ts)
    //
    // 조각은 앱이 UTC 로 옮겨서 저장한다. 그래서 여기서 시차를 다루지 않아도 되고,
    // 선생님이 어느 시간대에서 설정하든 서버 판단이 화면과 같아진다.
    function accessSlotNow() {
      // dayOfWeek() 는 1(월)~7(일) 이라 JS 의 0(일)~6(토) 에 맞춘다.
      return (request.time.dayOfWeek() % 7) * 10000
        + request.time.hours() * 100
        + (request.time.minutes() / 5) * 5;
    }

    function accessAllowedBy(cfg) {
      // accessMode 가 없던 시절의 문서는 gameOpen 만 보고 판단한다.
      let mode = cfg.get('accessMode', cfg.get('gameOpen', true) ? 'open' : 'closed');
      return mode == 'open'
        || (mode == 'schedule' && cfg.get('slots', []).hasAny([accessSlotNow()]));
    }

    // config/app 이 아예 없으면 열어 둔다. 설정 전에도 수업을 할 수 있어야 한다.
    function accessAllowed() {
      let snap = get(/databases/$(db)/documents/config/app);
      return snap == null || accessAllowedBy(snap.data);
    }

    // config/secret 은 교사 핀이 들어 있어 아무도 읽고 쓸 수 없다. (콘솔에서만 관리)
    // 보안 규칙 안의 get() 은 읽기 권한과 상관없이 값을 볼 수 있어서 대조가 가능하다.
    match /config/{doc} {
      allow read: if doc != 'secret';
      allow write: if isAdmin() && doc != 'secret';
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // 핀 번호로 여는 교사 세션.
    // 만들 때 규칙이 서버에서 핀을 대조하므로, 핀이 앱 코드에 들어가지 않는다.
    match /teacherSessions/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['pin', 'createdAt'])
        && request.resource.data.pin is string
        && request.resource.data.pin
             == get(/databases/$(db)/documents/config/secret).data.pin;
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /students/{studentId} {
      allow read: if true;
      allow create: if validStudentId(studentId)
        && validName(request.resource.data.name)
        && request.resource.data.keys().hasOnly(['name', 'classNo', 'createdAt'])
        && request.resource.data.classNo is int
        && request.resource.data.classNo >= 1
        && request.resource.data.classNo <= 20;
      allow update, delete: if isAdmin();
    }

    match /records/{recordId} {
      function d() { return request.resource.data; }
      function registeredName() {
        return get(/databases/$(db)/documents/students/$(d().studentId)).data.name;
      }
      function common() {
        return accessAllowed()
          && recordId == d().season + '_' + d().level + '_' + d().studentId
          && d().level in ['beginner', 'intermediate', 'expert']
          && d().name == registeredName()
          && d().updatedAt == request.time
          && d().keys().hasOnly(
              ['season', 'level', 'studentId', 'name', 'classNo',
               'plays', 'wins', 'bestTimeMs', 'bestAt', 'updatedAt']);
      }

      allow read: if true;

      allow create: if common()
        && d().plays == 1
        && ((d().wins == 0 && d().bestTimeMs == null)
          || (d().wins == 1 && d().bestTimeMs is int
              && d().bestTimeMs >= minTime(d().level)));

      // PRD 9.1 초안에서는 "승리했지만 최고 기록을 못 깬 판"을 저장할 수 없었다.
      // (wins +1 분기가 항상 더 빠른 bestTimeMs 를 요구했기 때문)
      // 아래처럼 "기록 유지" 경우를 함께 허용해야 실제 플레이와 맞는다.
      allow update: if common()
        && d().studentId == resource.data.studentId
        && d().level == resource.data.level
        && d().season == resource.data.season
        && d().plays == resource.data.plays + 1
        && (
          // 패배: 승수·최고 기록 그대로
          (d().wins == resource.data.wins
            && d().bestTimeMs == resource.data.bestTimeMs)
          // 승리: 승수 +1, 최고 기록은 유지하거나 더 빠른 값으로만 갱신
          || (d().wins == resource.data.wins + 1
            && (
              (resource.data.bestTimeMs != null && d().bestTimeMs == resource.data.bestTimeMs)
              || (d().bestTimeMs is int
                && d().bestTimeMs >= minTime(d().level)
                && (resource.data.bestTimeMs == null
                    || d().bestTimeMs <= resource.data.bestTimeMs))
            ))
        );

      allow delete: if isAdmin();
    }
  }
}
